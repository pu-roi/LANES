PROJECT_NAME="LANES"
API_VERSION="0.1.0"

# Database connection URL (PostgreSQL with PostGIS)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/lanes"

# OSRM pathfinding server URL (use public fallback or local instance)
OSRM_URL="https://router.project-osrm.org"

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
GRAPHHOPPER_API_KEY=""

# Resend Email Configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lanes <noreply@navlanes.live>"

# Google OAuth Configuration
GOOGLE_CLIENT_ID=""

# Independent news auditor: choose provider and a verified model explicitly.
# Leave both blank to keep external confirmation unavailable.
LANES_NEWS_AUDITOR_PROVIDER=""
LANES_NEWS_AUDITOR_MODEL=""
# Change after credential/access repair to preserve and supersede failed audits.
LANES_NEWS_AUDITOR_CONFIG_REVISION="1"
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Public feed retention after evidence expires; does not extend confirmation.
# Allowed range: 1-72 hours. Flood evidence still expires two hours after observation.
LANES_NEWS_UNCONFIRMED_RETENTION_HOURS="24"

