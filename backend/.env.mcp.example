# Copy to ignored .env.mcp.local; do not overwrite existing provider settings.
LANES_MCP_REVIEW_ENABLED=false
LANES_MCP_GATEWAY_ENABLED=false
LANES_MCP_BACKEND_URL=http://127.0.0.1:8005
# Your assigned ngrok development domain; expose only the OAuth-protected gateway.
LANES_MCP_PUBLIC_URL=https://mcp-dev.YOUR-DOMAIN
LANES_MCP_GOOGLE_CLIENT_ID=
LANES_MCP_GOOGLE_CLIENT_SECRET=
LANES_MCP_ALLOWED_GOOGLE_SUBJECT=
LANES_MCP_ALLOWED_EMAIL=
LANES_MCP_ASSERTION_PRIVATE_KEY_FILE=
LANES_MCP_ASSERTION_PUBLIC_KEY_FILE=
LANES_MCP_OAUTH_SIGNING_KEY=
LANES_MCP_OAUTH_STORAGE_DIRECTORY=
# Exact callback shown by ChatGPT. No wildcard redirect permissions.
LANES_MCP_CLIENT_REDIRECT_URIS=[]
# Use a newly migrated disposable local database; the launcher checks its name.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE-ME@127.0.0.1:55436/lanes_mcp_test_pilot
