# PDFs are binary documents, even when Git's content heuristic sees text.
*.pdf binary

# Immutable research captures must retain their original bytes and manifest hashes.
# Treat captured HTML/text as evidence artifacts rather than editable source files.
/docs/evaluations/**/sources/** binary

# Dated research exports and their builder identities are SHA-256 evidence.
# Preserve bytes on every OS so manifest verification survives a Git checkout.
/docs/evaluations/pasig-duration-*/**/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/evaluations/pasig-duration-*/**/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
